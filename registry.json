  "sides": {
    "seller-portal": {
      "label": "The seller portal",
      "description": "Where your sellers sign in: they buy from you here, and they run the store they sell from here. A B2B storefront plus the tools to run a store — which products it carries, what it charges, what it promotes, who its customers are, and what it is owed.",
      "inherits": [
        "B2B"
      ],
      "supported_models": [
        "B2B2C",
        "B2B2B"
      ]
    },
    "consumer-storefront": {
      "label": "The shopper storefront",
      "description": "The shop your sellers' own customers buy from. A B2C storefront where assortment, price, content and stock are all resolved from the one seller the shopper is bound to.",
      "inherits": [
        "B2C"
      ],
      "supported_models": [
        "B2B2C"
      ]
    },
    "business-storefront": {
      "label": "The business-buyer storefront",
      "description": "The shop your sellers' business customers buy from. The shopper storefront, plus a company account area — approvals, roles, company profile, shared lists — that appears once the person signing in turns out to be buying on a company's behalf.",
      "inherits": [
        "B2C",
        "B2B"
      ],
      "supported_models": [
        "B2B2B"
      ]
    }
  },
  "multi_sided_models": [
    "B2B2C",
    "B2B2B"
  ],
